# Security headers for every page (Cloudflare Workers static assets reads this file).
# The Content-Security-Policy keeps scripts to our own files (plus the one tiny theme script in index.html, pinned by hash) so injected
# script cannot run, and limits where the app may connect. If you add a new third-party service, add its host here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-EPZdc/JZtW9JZHepjfZo2LZQMeEONw9WQqVctcyYOj4=' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.livekit.cloud wss://*.livekit.cloud; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Built files have a content hash in their name, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
